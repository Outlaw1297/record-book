# Copy to .env (gitignored) before `docker compose up` or pasting into Portainer.
# Generate secrets: openssl rand -hex 24

POSTGRES_DB=recordbook
POSTGRES_USER=recordbook
POSTGRES_PASSWORD=change-me-now
API_KEY=change-me-api-key
CORS_ORIGIN=*

# Published ports on the Docker host / Portainer machine
WEB_PORT=80
API_PORT=8080
POSTGRES_PORT=5432

# Baked into the web image at build time. /api is proxied by nginx to the API.
VITE_RANCH_API_URL=/api
VITE_GOOGLE_CLIENT_ID=
VITE_DROPBOX_APP_KEY=
